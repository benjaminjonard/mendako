{% extends 'layout.html.twig' %}

{% block title %}
    {{ 'menu.untagged'|trans }}
{% endblock %}

{% block breadcrumb %}
    <li><a href="{{ path('app_tag_index') }}">{{ 'menu.tags'|trans }}</a></li>
    <li class="is-active"><a href="{{ path('app_tag_untagged') }}" aria-current="page">{{ 'menu.untagged'|trans }}</a></li>
{% endblock %}

{% block content %}
    <div class="column is-8 is-offset-2"
         data-controller="media-viewer"
         data-action="keydown@window->media-viewer#keydown"
    >
        {% for post in posts %}
            <div class="box untagged-post">
                <div class="columns is-vcentered">
                    <div class="column is-narrow">
                        <a class="is-clickable"
                           data-action="click->media-viewer#open"
                           data-media-src="{{ post.path ? asset(post.path) : '' }}"
                           data-media-mimetype="{{ post.mimetype }}"
                        >
                            {% if post.mimetype == 'image/svg+xml' %}
                                <img style="max-width: 120px; max-height: 120px;" src="{{ asset(post.path) }}" alt="">
                            {% else %}
                                <img style="max-width: 120px; max-height: 120px;" src="{{ asset(post.path|thumbnail(360)) }}" alt="">
                            {% endif %}
                        </a>
                    </div>
                    <div class="column">
                        <form action="{{ path('app_tag_untagged_add', {id: post.id}) }}" method="post">
                            <input type="hidden" name="_token" value="{{ csrf_token('untag_post') }}">
                            <div class="field" data-controller="autocomplete" style="position: relative;">
                                <div class="control">
                                    <textarea name="tags" class="textarea has-fixed-size" rows="2" autocomplete="off"
                                              placeholder="{{ 'label.tags'|trans }}"
                                              data-autocomplete-target="input"
                                              data-action="keyup->autocomplete#autocomplete"></textarea>
                                    <ul class="autocomplete-dropdown autocomplete-dropdown-textarea is-hidden" data-autocomplete-target="list"></ul>
                                </div>
                            </div>
                            <div class="field">
                                <div class="control">
                                    <button class="button is-primary" type="submit">{{ 'btn.submit'|trans }}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="notification">{{ 'message.no_untagged_posts'|trans }}</div>
        {% endfor %}

        <div class="modal staged-viewer" data-media-viewer-target="viewer">
            <div class="modal-background" data-action="click->media-viewer#close"></div>
            <div class="modal-content" data-media-viewer-target="viewerContent"></div>
            <button type="button" class="modal-close is-large" aria-label="close" data-action="click->media-viewer#close"></button>
        </div>
    </div>
{% endblock %}
