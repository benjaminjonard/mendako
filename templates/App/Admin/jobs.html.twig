{% extends 'layout.html.twig' %}

{% block title %}
    {{ 'title.jobs'|trans }}
{% endblock %}

{% block breadcrumb %}
    <li><a href="{{ path('app_admin_index') }}">{{ 'menu.admin'|trans }}</a></li>
    <li class="is-active"><a href="{{ path('app_admin_jobs') }}" aria-current="page">{{ 'title.jobs'|trans }}</a></li>
{% endblock %}

{% block content %}
    {# Same is-6 wrapper as the other tabs so the submenu keeps one width; the panel below sets its own width. #}
    <div class="column is-6 is-offset-3">
        {{ include('App/Admin/_submenu.html.twig') }}

        {# Jobs panel is a bit wider than the validation card (see .admin-panel-wide). #}
        <div class="box admin-panel admin-panel-wide" data-controller="job-status" data-job-status-url-value="{{ path('app_autotag_jobs') }}">
            <h2 class="subtitle">{{ 'title.jobs'|trans }}</h2>

            {% if autoTagEnabled %}
            <div data-job-status-key="tagging">
                <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                    <span class="has-text-weight-semibold">
                        {{ 'label.tag_existing_posts'|trans }}
                        <span class="has-text-grey has-text-weight-normal ml-1" style="cursor: help;" title="{{ 'label.tag_existing_posts_help'|trans }}">?</span>
                    </span>
                    <span class="tag is-light has-text-black" data-job-role="status">…</span>
                </div>
                <progress class="progress is-primary is-small mb-3" data-job-role="bar" value="0" max="100">0%</progress>
                <div class="is-flex is-align-items-center">
                    <form method="post" action="{{ path('app_autotag_tag_backlog') }}" class="mr-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('autotag_batch') }}">
                        <div class="buttons are-small has-addons mb-0">
                            <button class="button" type="submit" name="all" value="0" data-job-role="launch">{{ 'btn.tag_missing'|trans }}</button>
                            <button class="button" type="submit" name="all" value="1" data-job-role="launch">{{ 'btn.tag_all'|trans }}</button>
                        </div>
                    </form>
                    <form method="post" action="{{ path('app_jobs_cancel', {job: 'tagging'}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('job_cancel') }}">
                        <div class="buttons are-small mb-0">
                            <button class="button is-danger" type="submit" data-job-role="cancel" disabled>{{ 'btn.cancel'|trans }}</button>
                        </div>
                    </form>
                </div>
            </div>

            <hr>

            <div data-job-status-key="embedding">
                <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                    <span class="has-text-weight-semibold">
                        {{ 'label.embedding_pool'|trans }}
                        <span class="has-text-grey has-text-weight-normal ml-1" style="cursor: help;" title="{{ 'label.embedding_pool_help'|trans }}">?</span>
                    </span>
                    <span class="tag is-light has-text-black" data-job-role="status">…</span>
                </div>
                <progress class="progress is-primary is-small mb-3 is-hidden" data-job-role="bar" value="0" max="100">0%</progress>
                <div class="is-flex is-align-items-center">
                    <form method="post" action="{{ path('app_autotag_embed_backlog') }}" class="mr-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('autotag_embed') }}">
                        <div class="buttons are-small has-addons mb-0">
                            <button class="button" type="submit" name="all" value="0" data-job-role="launch">{{ 'btn.tag_missing'|trans }}</button>
                            <button class="button" type="submit" name="all" value="1" data-job-role="launch">{{ 'btn.tag_all'|trans }}</button>
                        </div>
                    </form>
                    <form method="post" action="{{ path('app_jobs_cancel', {job: 'embedding'}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('job_cancel') }}">
                        <div class="buttons are-small mb-0">
                            <button class="button is-danger" type="submit" data-job-role="cancel" disabled>{{ 'btn.cancel'|trans }}</button>
                        </div>
                    </form>
                </div>
            </div>

            <hr>
            {% endif %}

            {# Duplicate-detection vectors — core feature, shown even when auto-tagging is disabled. #}
            <div data-job-status-key="vectors">
                <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                    <span class="has-text-weight-semibold">
                        {{ 'label.duplicate_vectors'|trans }}
                        <span class="has-text-grey has-text-weight-normal ml-1" style="cursor: help;" title="{{ 'label.duplicate_vectors_help'|trans }}">?</span>
                    </span>
                    <span class="tag is-light has-text-black" data-job-role="status">…</span>
                </div>
                <progress class="progress is-primary is-small mb-3" data-job-role="bar" value="0" max="100">0%</progress>
                <div class="is-flex is-align-items-center">
                    <form method="post" action="{{ path('app_vectors_backlog') }}" class="mr-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('autotag_vectors') }}">
                        <div class="buttons are-small has-addons mb-0">
                            <button class="button" type="submit" name="all" value="0" data-job-role="launch">{{ 'btn.tag_missing'|trans }}</button>
                            <button class="button" type="submit" name="all" value="1" data-job-role="launch">{{ 'btn.tag_all'|trans }}</button>
                        </div>
                    </form>
                    <form method="post" action="{{ path('app_jobs_cancel', {job: 'vectors'}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('job_cancel') }}">
                        <div class="buttons are-small mb-0">
                            <button class="button is-danger" type="submit" data-job-role="cancel" disabled>{{ 'btn.cancel'|trans }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
