{% extends 'layout.html.twig' %}

{% block title %}
    {{ 'menu.admin'|trans }}
{% endblock %}

{% block breadcrumb %}
    <li class="is-active"><a href="#" aria-current="page">{{ 'menu.admin'|trans }}</a></li>
{% endblock %}

{% block content %}
    <div class="column"></div>

    <div class="column">
        <div class="box">
            <h1 class="title">{{ 'title.admin'|trans }}</h1>
            <h2 class="subtitle">{{ 'title.configuration'|trans }}</h2>
            <div class="config">
                <b>{{ 'label.release'|trans }}</b>: {{ release }}
            </div>
            <div class="config">
                <b>{{ 'label.php_version'|trans }}</b>: {{ phpVersion }}
            </div>
            <div class="config">
                <b>{{ 'label.symfony_version'|trans }}</b>: {{ symfonyVersion }}
            </div>
            <div class="config">
                <b>{{ 'label.frankenphp_version'|trans }}</b>: {{ frankenPhpVersion }}
            </div>
            <br>

            <div class="config">
                <b>{{ 'label.thumbnails_format'|trans }}</b>: {{ thumbnailsFormat }}
            </div>
            <div class="config">
                <b>{{ 'label.post_per_page'|trans }}</b>: {{ postPerPage }}
            </div>
            <div class="config">
                <b>{{ 'label.infinite_scroll_post_per_page'|trans }}</b>: {{ infiniteScrollPostPerPage }}
            </div>
            <br>

            <div class="config">
                <b>{{ 'label.boards'|trans }}</b>: {{ boards }}
            </div>
            <div class="config">
                <b>{{ 'label.posts'|trans }}</b>: {{ posts }}
            </div>
            <div class="config">
                <b>{{ 'label.disk_usage'|trans }}</b>: {{ diskUsage|bytes }}
            </div>
            <br>

            <div class="config">
                <b>{{ 'menu.automatic_tags'|trans }}</b>:
                <span class="tag {{ autoTagEnabled ? 'is-success' : 'is-light' }}">
                    {{ (autoTagEnabled ? 'label.enabled' : 'label.disabled')|trans }}
                </span>
            </div>
        </div>

        <div class="box" data-controller="job-status" data-job-status-url-value="{{ path('app_autotag_jobs') }}">
            <h2 class="subtitle">{{ 'title.jobs'|trans }}</h2>

            {% if autoTagEnabled %}
            <div data-job-status-key="tagging">
                <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                    <span class="has-text-weight-semibold">{{ 'label.tag_existing_posts'|trans }}</span>
                    <span class="tag is-light has-text-black" data-job-role="status">…</span>
                </div>
                <progress class="progress is-primary is-small mb-3" data-job-role="bar" value="0" max="100">0%</progress>
                <form method="post" action="{{ path('app_autotag_tag_backlog') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('autotag_batch') }}">
                    <div class="buttons are-small has-addons">
                        <button class="button" type="submit" name="all" value="0" data-job-role="launch">{{ 'btn.tag_missing'|trans }}</button>
                        <button class="button" type="submit" name="all" value="1" data-job-role="launch">{{ 'btn.tag_all'|trans }}</button>
                    </div>
                </form>
            </div>

            <hr>

            <div data-job-status-key="embedding">
                <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                    <span class="has-text-weight-semibold">{{ 'label.embedding_pool'|trans }}</span>
                    <span class="tag is-light has-text-black" data-job-role="status">…</span>
                </div>
                <progress class="progress is-primary is-small mb-3 is-hidden" data-job-role="bar" value="0" max="100">0%</progress>
                <form method="post" action="{{ path('app_autotag_embed_backlog') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('autotag_embed') }}">
                    <div class="buttons are-small has-addons">
                        <button class="button" type="submit" name="all" value="0" data-job-role="launch">{{ 'btn.tag_missing'|trans }}</button>
                        <button class="button" type="submit" name="all" value="1" data-job-role="launch">{{ 'btn.tag_all'|trans }}</button>
                    </div>
                </form>
            </div>

            <hr>
            {% endif %}

            {# Duplicate-detection vectors — core feature, shown even when auto-tagging is disabled. #}
            <div data-job-status-key="vectors">
                <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                    <span class="has-text-weight-semibold">{{ 'label.duplicate_vectors'|trans }}</span>
                    <span class="tag is-light has-text-black" data-job-role="status">…</span>
                </div>
                <progress class="progress is-primary is-small mb-3" data-job-role="bar" value="0" max="100">0%</progress>
                <form method="post" action="{{ path('app_vectors_backlog') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('autotag_vectors') }}">
                    <div class="buttons are-small has-addons">
                        <button class="button" type="submit" name="all" value="0" data-job-role="launch">{{ 'btn.tag_missing'|trans }}</button>
                        <button class="button" type="submit" name="all" value="1" data-job-role="launch">{{ 'btn.tag_all'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="column"></div>
{% endblock %}