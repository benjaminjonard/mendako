{% extends 'layout.html.twig' %}

{% block title %}
    {{ 'menu.admin'|trans }}
{% endblock %}

{% block breadcrumb %}
    <li class="is-active"><a href="#" aria-current="page">{{ 'menu.admin'|trans }}</a></li>
{% endblock %}

{% block content %}
    <div class="column"></div>

    <div class="column">
        <div class="box">
            <h1 class="title">{{ 'title.admin'|trans }}</h1>
            <h2 class="subtitle">{{ 'title.configuration'|trans }}</h2>
            <div class="config">
                <b>{{ 'label.release'|trans }}</b>: {{ release }}
            </div>
            <div class="config">
                <b>{{ 'label.php_version'|trans }}</b>: {{ phpVersion }}
            </div>
            <div class="config">
                <b>{{ 'label.symfony_version'|trans }}</b>: {{ symfonyVersion }}
            </div>
            <div class="config">
                <b>{{ 'label.frankenphp_version'|trans }}</b>: {{ frankenPhpVersion }}
            </div>
            <br>

            <div class="config">
                <b>{{ 'label.thumbnails_format'|trans }}</b>: {{ thumbnailsFormat }}
            </div>
            <div class="config">
                <b>{{ 'label.post_per_page'|trans }}</b>: {{ postPerPage }}
            </div>
            <div class="config">
                <b>{{ 'label.infinite_scroll_post_per_page'|trans }}</b>: {{ infiniteScrollPostPerPage }}
            </div>
            <br>

            <div class="config">
                <b>{{ 'label.boards'|trans }}</b>: {{ boards }}
            </div>
            <div class="config">
                <b>{{ 'label.posts'|trans }}</b>: {{ posts }}
            </div>
            <div class="config">
                <b>{{ 'label.disk_usage'|trans }}</b>: {{ diskUsage|bytes }}
            </div>
            <br>

            <div class="config">
                <b>{{ 'menu.automatic_tags'|trans }}</b>:
                <span class="tag {{ autoTagEnabled ? 'is-success' : 'is-light' }}">
                    {{ (autoTagEnabled ? 'label.enabled' : 'label.disabled')|trans }}
                </span>
            </div>
        </div>

        {% if autoTagEnabled %}
        <div class="box">
            <h2 class="subtitle">{{ 'title.jobs'|trans }}</h2>

            <div data-controller="batch-status"
                 data-batch-status-url-value="{{ path('app_autotag_batch_status') }}"
                 data-batch-status-active-label-value="{{ 'label.run_active'|trans }}"
                 data-batch-status-idle-label-value="{{ 'label.run_idle'|trans }}"
                 data-batch-status-remaining-label-value="{{ 'label.run_remaining'|trans }}"
                 data-batch-status-vocab-label-value="{{ 'label.vocab_warming'|trans }}">
                <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                    <span class="has-text-weight-semibold">{{ 'label.tag_existing_posts'|trans }}</span>
                    <span class="tag is-light" data-batch-status-target="status">…</span>
                </div>
                <p class="notification is-info is-light py-2 px-3 mb-3 is-hidden" data-batch-status-target="vocab"></p>
                <progress class="progress is-primary is-small mb-3" data-batch-status-target="bar" value="0" max="100">0%</progress>
                <form method="post" action="{{ path('app_autotag_tag_backlog') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('autotag_batch') }}">
                    <div class="buttons are-small has-addons">
                        <button class="button" type="submit" name="all" value="0" data-batch-status-target="launch">{{ 'btn.tag_missing'|trans }}</button>
                        <button class="button" type="submit" name="all" value="1" data-batch-status-target="launch">{{ 'btn.tag_all'|trans }}</button>
                    </div>
                </form>
            </div>

            <hr>

            <div data-controller="cache-status"
                 data-cache-status-url-value="{{ path('app_autotag_cache_status') }}"
                 data-cache-status-encoding-label-value="{{ 'label.vocab_warming'|trans }}"
                 data-cache-status-cached-label-value="{{ 'label.tags_cached'|trans }}"
                 data-cache-status-missing-label-value="{{ 'label.tags_to_encode'|trans }}"
                 data-cache-status-up-to-date-label-value="{{ 'label.cache_up_to_date'|trans }}">
                <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                    <span class="has-text-weight-semibold">{{ 'label.tag_cache'|trans }}</span>
                    <span class="tag is-light" data-cache-status-target="status">…</span>
                </div>
                <progress class="progress is-primary is-small mb-3 is-hidden" data-cache-status-target="bar" value="0" max="100">0%</progress>
                <form method="post" action="{{ path('app_autotag_cache_encode') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('autotag_cache') }}">
                    <div class="buttons are-small has-addons">
                        <button class="button" type="submit" name="all" value="0" data-cache-status-target="encode encodeMissing">{{ 'btn.tag_missing'|trans }}</button>
                        <button class="button" type="submit" name="all" value="1" data-cache-status-target="encode">{{ 'btn.tag_all'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
        {% endif %}
    </div>

    <div class="column"></div>
{% endblock %}