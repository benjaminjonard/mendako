{% extends 'layout.html.twig' %}

{% block title %}
    {{ 'menu.admin'|trans }}
{% endblock %}

{% block breadcrumb %}
    <li class="is-active"><a href="#" aria-current="page">{{ 'menu.admin'|trans }}</a></li>
{% endblock %}

{% block content %}
    {# Same is-6 wrapper as the other tabs so the submenu keeps one width; the panel below sets its own width. #}
    <div class="column is-6 is-offset-3">
        {{ include('App/Admin/_submenu.html.twig') }}

        {# Configuration panel matches the validation card width (see .admin-panel). #}
        <div class="box admin-panel">
            <h2 class="subtitle">{{ 'title.configuration'|trans }}</h2>
            <div class="config">
                <b>{{ 'label.release'|trans }}</b>: {{ release }}
            </div>
            <div class="config">
                <b>{{ 'label.php_version'|trans }}</b>: {{ phpVersion }}
            </div>
            <div class="config">
                <b>{{ 'label.symfony_version'|trans }}</b>: {{ symfonyVersion }}
            </div>
            <div class="config">
                <b>{{ 'label.frankenphp_version'|trans }}</b>: {{ frankenPhpVersion }}
            </div>
            <br>

            <div class="config">
                <b>{{ 'label.thumbnails_format'|trans }}</b>: {{ thumbnailsFormat }}
            </div>
            <div class="config">
                <b>{{ 'label.post_per_page'|trans }}</b>: {{ postPerPage }}
            </div>
            <div class="config">
                <b>{{ 'label.infinite_scroll_post_per_page'|trans }}</b>: {{ infiniteScrollPostPerPage }}
            </div>
            <br>

            <div class="config">
                <b>{{ 'label.boards'|trans }}</b>: {{ boards }}
            </div>
            <div class="config">
                <b>{{ 'label.posts'|trans }}</b>: {{ posts }}
            </div>
            <div class="config">
                <b>{{ 'label.disk_usage'|trans }}</b>: {{ diskUsage|bytes }}
            </div>
            <br>

            <div class="config">
                <b>{{ 'menu.automatic_tags'|trans }}</b>:
                <span class="tag {{ autoTagEnabled ? 'is-success' : 'is-light' }}">
                    {{ (autoTagEnabled ? 'label.enabled' : 'label.disabled')|trans }}
                </span>
            </div>
            {% if autoTagEnabled %}
                <div class="config">
                    <b>{{ 'label.autotag_autovalidate_threshold'|trans }}</b>: {{ autoTagAutoValidateThreshold }}&nbsp;%
                </div>
                {% for source, boards in {'wd': autoTagWdBoards, 'ram': autoTagRamBoards} %}
                    <div class="config">
                        <b>{{ 'label.autotag_boards'|trans }} — {{ ('label.source_' ~ source)|trans }}</b>:
                        {% if '*' in boards %}
                            {{ 'label.autotag_boards_all'|trans }}
                        {% elseif boards is empty %}
                            {{ 'label.autotag_boards_none'|trans }}
                        {% else %}
                            {{ boards|join(', ') }}
                        {% endif %}
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
{% endblock %}
