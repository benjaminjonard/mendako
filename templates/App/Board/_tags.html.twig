{% set sortedTags = tags|naturalSorting %}
{% for category in ['rating', 'artist', 'copyright', 'character', 'general', 'meta'] %}
    {% set categoryTags = sortedTags|filter(t => t.category == category) %}
    {% if categoryTags is not empty %}
        <div class="block mb-3" data-category="{{ category }}">
            <h3 class="has-text-weight-semibold">{{ ('app.enum.tag.category.' ~ category)|trans }}</h3>
            {% for tag in categoryTags %}
                <div data-infinite-scroll-target="tag" data-id="{{ tag.id }}"><a class="is-category-{{ category }}" href="{{ path('app_board_show', {slug: board.slug, tags: tag.name}) }}">{{ tag.name }}</a> ({{ tag.counter }})</div>
            {% endfor %}
        </div>
    {% endif %}
{% endfor %}
