{
    "name": "benjaminjonard/mendako",
    "description": "Mendako is a self-hosted, private, light booru like image board, supports multiple boards. ",
    "type": "project",
    "license": "MIT",
    "version": "1.4.0",
    "minimum-stability": "stable",  
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "contao/imagine-svg": "^1.0",
        "doctrine/doctrine-bundle": "3.2.2",
        "doctrine/doctrine-migrations-bundle": "4.0.0",
        "doctrine/orm": "3.6.5",
        "gedmo/doctrine-extensions": "3.22.0",
        "php-ffmpeg/php-ffmpeg": "v1.4.0",
        "stof/doctrine-extensions-bundle": "1.15.3",
        "symfony/asset": "8.0.8",
        "symfony/browser-kit": "8.0.8",
        "symfony/cache": "8.0.10",
        "symfony/console": "8.0.11",
        "symfony/css-selector": "8.0.9",
        "symfony/dependency-injection": "8.0.10",
        "symfony/dotenv": "8.0.11",
        "symfony/event-dispatcher": "8.0.9",
        "symfony/expression-language": "8.0.8",
        "symfony/flex": "2.10.0",
        "symfony/form": "8.0.9",
        "symfony/framework-bundle": "8.0.11",
        "symfony/mime": "8.0.9",
        "symfony/monolog-bundle": "4.0.2",
        "symfony/routing": "8.0.9",
        "symfony/runtime": "8.0.8",
        "symfony/security-bundle": "8.0.11",
        "symfony/string": "8.0.11",
        "symfony/translation": "8.0.10",
        "symfony/twig-bundle": "8.0.8",
        "symfony/uid": "8.0.9",
        "symfony/validator": "8.0.10",
        "symfony/webpack-encore-bundle": "2.4.0",
        "symfony/yaml": "8.0.11",
        "twig/extra-bundle": "3.24.0",
        "twig/intl-extra": "3.24.0",
        "twig/twig": "3.26.0"
    },
    "require-dev": {
        "brianium/paratest": "7.22.4",
        "dama/doctrine-test-bundle": "8.6.0",
        "phpunit/php-code-coverage": "14.1.9",
        "phpunit/phpunit": "13.1.10",
        "rector/rector": "2.4.3",
        "symfony/debug-bundle": "8.0.8",
        "symfony/maker-bundle": "1.67.0",
        "symfony/stopwatch": "8.0.8",
        "symfony/web-profiler-bundle": "8.0.11",
        "zenstruck/foundry": "2.9.2"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "Composer\\Config::disableProcessTimeout",
            "./vendor/phpunit/phpunit/phpunit --color=always --coverage-html=\"output/code-coverage\""
        ],
        "test:phpunit": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/phpunit/phpunit/phpunit"
        ],
        "test:paratest": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/paratest --runner=WrapperRunner"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "docker": false,
            "require": "8.0.*"
        },
        "runtime": {
            "class": "Symfony\\Component\\Runtime\\SymfonyRuntime"
        }
    }
}
